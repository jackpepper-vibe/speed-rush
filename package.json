{
  "name": "speed-rush",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Speed Rush — a three-lane-turned-five-lane endless racer rebuilt on a managed, event-driven core.",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview --port 5180",
    "probe": "node tools/probe.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
